{
  "name": "reflax-local-deployment",
  "version": "1.0.0",
  "description": "Local deployment utilities for ReFlax protocol",
  "scripts": {
    "start": "./scripts/deployWithServer.sh",
    "deploy": "./scripts/deployWithServer.sh",
    "start-anvil": "anvil --host 0.0.0.0 --port 8545",
    "start-server": "node scripts/addressServer.js",
    "deploy-contracts": "PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80 forge script scripts/DeployLocal.s.sol:LocalDeploymentScript --rpc-url http://localhost:8545 --broadcast --ffi",
    "stop": "./scripts/cleanup.sh",
    "health": "curl -s http://localhost:3011/health | jq",
    "addresses": "curl -s http://localhost:3011/api/contract-addresses | jq",
    "install-deps": "npm install"
  },
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5"
  },
  "devDependencies": {},
  "keywords": ["defi", "ethereum", "reflax", "local-deployment"],
  "author": "",
  "license": "MIT"
}